{
  "tasks": {
    "dev": "deno run -A @effectionx/watch deno run -A main.tsx",
    "staticalize": "deno run -A jsr:@frontside/staticalize@0.2.1/cli --site http://localhost:8000 --output=built --base=http://localhost:8000",
    "pagefind": "npx pagefind --site built",
    "test": "deno test --allow-run --allow-write --allow-read",
    "clear-cache": "deno run -A tasks/clear-cache.ts"
  },
  "lint": {
    "exclude": ["docs/esm"],
    "rules": {
      "exclude": [
        "prefer-const",
        "require-yield",
        "jsx-curly-braces",
        "jsx-key",
        "jsx-no-useless-fragment"
      ]
    }
  },
  "fmt": {
    "exclude": ["docs/esm"]
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom.iterable", "dom"],
    "jsx": "react-jsx",
    "jsxImportSource": "revolution"
  },
  "imports": {
    "effection": "npm:effection@3.6.0",
    "@effectionx/deno-deploy": "npm:@effectionx/deno-deploy@0.1.1",
    "@effectionx/watch": "jsr:@effectionx/watch@0.1.2",
    "unified": "npm:unified@11.0.4",
    "revolution": "https://deno.land/x/revolution@0.6.1/mod.ts",
    "revolution/jsx-runtime": "https://deno.land/x/revolution@0.6.1/jsx-runtime.ts",
    "@tailwindcss/typography": "npm:@tailwindcss/typography@^0.5.16",
    "tailwindcss": "npm:tailwindcss@^4.1.0",
    "@deno/doc": "jsr:@deno/doc@0.181.0",
    "git-url-parse": "npm:git-url-parse@16.1.0",
    "@std/fs": "jsr:@std/fs@1",
    "@std/path": "jsr:@std/path@1",
    "@std/testing": "jsr:@std/testing@1",
    "md5": "npm:md5@^2.3.0",
    "expect": "jsr:@std/expect@^1"
  }
}
