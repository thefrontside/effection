{
  "name": "@effection/effection",
  "exports": "./mod.ts",
  "license": "ISC",
  "publish": {
    "include": ["lib", "mod.ts", "README.md"]
  },
  "lock": false,
  "tasks": {
    "test": "deno test --allow-run --allow-write --allow-read --allow-env --allow-ffi",
    "test:node": "deno task build:npm 0.0.0 && node test/main/node.mjs hello world",
    "build:jsr": "deno run -A tasks/build-jsr.ts",
    "build:npm": "deno run -A tasks/build-npm.ts"
  },
  "lint": {
    "rules": {
      "exclude": ["prefer-const", "require-yield"]
    },
    "exclude": [
      "build",
      "website",
      "www/build",
      "packages"
    ]
  },
  "fmt": {
    "exclude": [
      "build",
      "website",
      "www/build",
      "packages",
      "CODE_OF_CONDUCT.md",
      "README.md"
    ]
  },
  "test": {
    "exclude": [
      "build",
      "packages"
    ]
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "esnext",
      "dom",
      "dom.iterable"
    ]
  },
  "deploy": {
    "org": "Frontside",
    "project": "effection-www",
    "entrypoint": "https://jsr.io/@std/http/1.0.20/file_server.ts",
    "root": "./www"
  },
  "nodeModulesDir": "auto",
  "workspace": [
    "./www"
  ],
  "imports": {
    "https://deno.land/x/path_to_regexp@v6.2.1/index.ts": "npm:path-to-regexp@8.2.0",
    "@std/path/posix/basename": "jsr:@std/path@1/posix/basename",
    "remark-gfm": "npm:remark-gfm@3.0.1",
    "rehype-prism-plus": "npm:rehype-prism-plus@1.5.1",
    "@mdx-js/mdx": "npm:@mdx-js/mdx@2.3.0",
    "@std/testing/bdd": "jsr:@std/testing@^1/bdd",
    "@std/expect": "jsr:@std/expect@^1",
    "ts-expect": "npm:ts-expect@1.3.0",
    "ctrlc-windows": "npm:ctrlc-windows@2.2.0",
    "@deno/dnt": "jsr:@deno/dnt@0.41.3"
  }
}
